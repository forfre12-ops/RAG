# ============================================================
# Koipa PoC — Profile: onprem-local
# 대상: GPU 보유, 폐쇄망 (외부 API 호출 0)
# Ollama/vLLM/LM Studio + KURE/BGE 임베딩 + reranker=noop(recall 무개선·CPU 5배 → 폐쇄망 기본 미사용)
# ============================================================

DEPLOY_PROFILE=onprem-local

# 프로파일 default:
#   LLM_PROVIDER=ollama       (vllm·lm_studio도 가능)
#   EMBEDDING_PROVIDER=hf
#   RERANKER_PROVIDER=noop    (실측 recall 무개선·CPU 5배 → 폐쇄망 기본 미사용)
#   VECTOR_BACKEND=pg         (pgvector dense + ts_rank 하이브리드 — ES 폐기)
#   STORAGE_BACKEND=local     (폐쇄망=로컬FS file://, MinIO 미사용)
#   ENABLE_TRAINING=false
#   POC_MODE=full

# --- 필수 ---
API_KEY=replace_me_api_key

# --- 로컬 LLM endpoint ---
# 시나리오 A: Ollama (기본)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:14b
LOCAL_LLM_API_KEY=ollama
# 시나리오 B: vLLM
# LLM_PROVIDER=vllm
# LOCAL_LLM_BASE_URL=http://localhost:8001/v1
# LOCAL_LLM_MODEL=Qwen/Qwen3-14B
# LOCAL_LLM_API_KEY=EMPTY

# --- 인프라 ---
DATABASE_URL=postgresql+psycopg://koipa:koipa_dev@localhost:5432/koipa
REDIS_URL=redis://localhost:6379/0
# 벡터스토어=Postgres(pgvector). ES 미사용 — ES_URL/ES_PASSWORD 불필요(§03 ES→PG 단일화).
# 저장소=로컬FS(.storage). MinIO 미사용 — MINIO_* 불필요(폐쇄망 결정).

# --- 원본 at-rest 암호화 (영업비밀 평문저장 방지) ---
# ENABLED=1 인데 KEY 미설정이면 운영(poc_mode=full) startup fail-fast. 키는 32바이트+ 고엔트로피
# (python -c "import secrets;print(secrets.token_hex(32))"). 키 분실 시 기존 원본 복호 불가.
STORAGE_ENCRYPTION_ENABLED=1
STORAGE_ENCRYPTION_KEY=replace_me_64hex_random

# --- 모델 ---
EMBEDDING_MODEL=nlpai-lab/KURE-v1
# 분류 학습 가중치(KF-DeBERTa) — 미설정("")이면 활성 ModelVersion 없을 때 rule-fallback-v0 무음 서빙
# (readiness 보증 F1 0.938·FNR 0.043 전제 붕괴). readiness가 보증하는 모델과 반드시 일치(model parity).
# .env.prod.example 과 동일 경로.
CLASSIFIER_MODEL_DIR=artifacts/classifier_p1_v5_clean/v-fe4b386b

# 골든 후보 관리 화면이 처음 열릴 때 좁혀 보는 검수 배치. 후보 풀에는 예전 회차가 지워지지 않고
# 쌓이므로(2026-09-25 실측 3,598건 = 이번 회차 1,731 + 같은 문서의 중복 적재 800 + 옛 후보 1,067) 기본을 이번 회차로 둔다. 화면에서
# 「전체 배치」로 언제든 바꿀 수 있고, 이 배치가 서버에 없으면 자동으로 전체를 보여 준다.
GOLDEN_DEFAULT_REVIEW_BATCH=expert_review_1731_20260924

# 외부 전문가 블라인드 검수 — 기본값이 꺼짐(False)이라 이 줄이 없으면 검수자 화면에 제안 등급·근거가 그대로 보여
# 독립 판정이 깨진다(오류 없이 조용히 그렇게 됨). setup.sh 가 만드는 .env 는 이미 1 이고, 이 템플릿을 직접 복사해
# 배포해도 같아야 한다. 검수자별로 문서를 나눠 배정하려면 GOLDEN_REVIEWER_ASSIGNMENT_ENFORCED=1 을 따로 켠다.
GOLDEN_REVIEW_BLIND_ENFORCED=1

# --- 골든 검수 콘솔 로그인 (JWT) ---
# 결정 저장(POST /golden/candidates/{doc_id}/decision) 등 콘솔의 쓰기 계열은 공유 API_KEY 를
# 받지 않고 포털 JWT 쿠키만 받는다("golden console requires a portal JWT login; shared API keys
# are not allowed") — 등급을 누가 정했는지 실계정으로 남겨야 검수 기록이 성립하기 때문이다.
# 아래를 안 채우면 AUTH_MODE 기본값(api_key)이 그대로 남아 **누구도 콘솔에 로그인하지 못한다**
# (로그인 화면은 "토큰이 잘못됐다"고 뜨지만 실제 원인은 서버가 JWT 자체를 검증 안 하는 것 —
# 2026-09-24 로컬 재현 확인, 이 값들이 비어 있던 게 원인이었다).
# JWT_JWKS_PATH 가 secrets/ 가 아니라 datasets/ 밑인 이유: 컨테이너는 secrets/ 를 마운트하지
# 않는다(golden_data 볼륨만 /app/datasets 로 영속— setup_console_test_login.py --also-copy-jwks
# 의 자체 설명). 발급은 컨테이너 안에서:
#   docker compose ... exec api python scripts/setup_console_test_login.py \
#     --sub <검수자이름> --roles reviewer --also-copy-jwks datasets/_console_jwt/jwks.json
AUTH_MODE=both
JWT_JWKS_PATH=datasets/_console_jwt/jwks.json
JWT_ISSUER=koipa-console
JWT_AUDIENCE=koipa-api

# --- 배포 게이트 · locked_gold_eval (사람서명 평가정답) ---
# 골든셋 검수(POST /golden/jobs/{id}/signoff, publish=true)가 승격한 사람서명 평가정답을 이 경로에
# 누적하고, 배포 게이트(자동활성 deploy_gate_require_locked_eval / 수동활성
# deploy_gate_manual_require_locked_eval)와 locked-eval readiness 가 이 경로를 읽는다. 미설정("")이면
# readiness=no_locked_records(무실데이터 fail-closed) — 서명이 게이트에 도달하지 못한다. 등급별 5건
# 이상 서명 누적되면 readiness=ready → 배포 게이트 통과(force 불요). 컨테이너 read-only 루트면 이
# 경로를 쓰기 가능 볼륨으로 마운트할 것.
LOCKED_EVAL_JSONL=datasets/gold_real/locked_gold_eval.jsonl
