# ============================================================
# Lloydk PoC — Profile: onprem-local
# 대상: GPU 보유, 폐쇄망 (외부 API 호출 0)
# Ollama/vLLM/LM Studio + KURE/BGE 임베딩 + BGE reranker
# ============================================================

DEPLOY_PROFILE=onprem-local

# 프로파일 default:
#   LLM_PROVIDER=ollama       (vllm·lm_studio도 가능)
#   EMBEDDING_PROVIDER=hf
#   RERANKER_PROVIDER=bge
#   VECTOR_BACKEND=es
#   STORAGE_BACKEND=minio
#   ENABLE_TRAINING=false
#   POC_MODE=full

# --- 필수 ---
API_KEY=replace_me_api_key

# --- 로컬 LLM endpoint ---
# 시나리오 A: Ollama (기본)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:14b
LOCAL_LLM_API_KEY=ollama
# 시나리오 B: vLLM
# LLM_PROVIDER=vllm
# LOCAL_LLM_BASE_URL=http://localhost:8001/v1
# LOCAL_LLM_MODEL=Qwen/Qwen3-14B
# LOCAL_LLM_API_KEY=EMPTY

# --- 인프라 ---
DATABASE_URL=postgresql+psycopg://lloydk:lloydk_dev@localhost:5432/lloydk
REDIS_URL=redis://localhost:6379/0
ES_URL=http://localhost:9200
ES_PASSWORD=replace_me_es

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=lloydk
MINIO_SECRET_KEY=replace_me_minio

# --- 모델 ---
EMBEDDING_MODEL=nlpai-lab/KURE-v1
