# ============================================================
# Lloydk PoC — Profile: onprem-local
# 대상: GPU 보유, 폐쇄망 (외부 API 호출 0)
# Ollama/vLLM/LM Studio + KURE/BGE 임베딩 + BGE reranker
# ============================================================

DEPLOY_PROFILE=onprem-local

# 프로파일 default:
#   LLM_PROVIDER=ollama       (vllm·lm_studio도 가능)
#   EMBEDDING_PROVIDER=hf
#   RERANKER_PROVIDER=bge
#   VECTOR_BACKEND=pg         (pgvector dense + ts_rank 하이브리드 — ES 폐기)
#   STORAGE_BACKEND=local     (폐쇄망=로컬FS file://, MinIO 미사용)
#   ENABLE_TRAINING=false
#   POC_MODE=full

# --- 필수 ---
API_KEY=replace_me_api_key

# --- 로컬 LLM endpoint ---
# 시나리오 A: Ollama (기본)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:14b
LOCAL_LLM_API_KEY=ollama
# 시나리오 B: vLLM
# LLM_PROVIDER=vllm
# LOCAL_LLM_BASE_URL=http://localhost:8001/v1
# LOCAL_LLM_MODEL=Qwen/Qwen3-14B
# LOCAL_LLM_API_KEY=EMPTY

# --- 인프라 ---
DATABASE_URL=postgresql+psycopg://lloydk:lloydk_dev@localhost:5432/lloydk
REDIS_URL=redis://localhost:6379/0
# 벡터스토어=Postgres(pgvector). ES 미사용 — ES_URL/ES_PASSWORD 불필요(§03 ES→PG 단일화).
# 저장소=로컬FS(.storage). MinIO 미사용 — MINIO_* 불필요(폐쇄망 결정).

# --- 원본 at-rest 암호화 (영업비밀 평문저장 방지) ---
# ENABLED=1 인데 KEY 미설정이면 운영(poc_mode=full) startup fail-fast. 키는 32바이트+ 고엔트로피
# (python -c "import secrets;print(secrets.token_hex(32))"). 키 분실 시 기존 원본 복호 불가.
STORAGE_ENCRYPTION_ENABLED=1
STORAGE_ENCRYPTION_KEY=replace_me_64hex_random

# --- 모델 ---
EMBEDDING_MODEL=nlpai-lab/KURE-v1
