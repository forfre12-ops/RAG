# ============================================================
# Koipa PoC — Profile: full-train
# 대상: KOIPA 풀스펙 (GPU 24GB+ · 학습 라우터 활성)
# 외부 API + KURE/BGE 임베딩 + reranker=noop + /api/v1/training/* 노출
# ============================================================

DEPLOY_PROFILE=full-train

# 프로파일 default:
#   LLM_PROVIDER=anthropic
#   EMBEDDING_PROVIDER=hf
#   RERANKER_PROVIDER=noop    (실측 recall 무개선·CPU 5배)
#   VECTOR_BACKEND=pg         (pgvector dense + ts_rank 하이브리드 — ES 폐기)
#   STORAGE_BACKEND=local     (로컬FS, MinIO 미사용 결정 2026-06-24)
#   ENABLE_TRAINING=true        ← 학습 라우터 등록됨
#   POC_MODE=full

# --- 필수 ---
API_KEY=replace_me_api_key
ANTHROPIC_API_KEY=sk-ant-...

# --- 인프라 ---
DATABASE_URL=postgresql+psycopg://koipa:koipa_dev@localhost:5432/koipa
REDIS_URL=redis://localhost:6379/0
# ES·MinIO 미사용 — 프로파일 default 가 vector=pg / storage=local 을 강제한다(위 헤더).
# 아래는 참고용이며 런타임 미사용. ES/MinIO 를 실제로 쓰려면 VECTOR_BACKEND=/STORAGE_BACKEND= 를
# 명시적으로 덮어써야 하나, 폐쇄망 결정(2026-06-24)상 권장하지 않음.
# ES_URL=http://localhost:9200
# ES_PASSWORD=replace_me_es
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=koipa
# MINIO_SECRET_KEY=replace_me_minio

# --- 모델 ---
LLM_MODEL=claude-sonnet-4-6
CLASSIFIER_BASE_MODEL=kakaobank/kf-deberta-base
EMBEDDING_MODEL=nlpai-lab/KURE-v1

# 골든 후보 관리 화면이 처음 열릴 때 좁혀 보는 검수 배치. 후보 풀에는 예전 회차가 지워지지 않고
# 쌓이므로(2026-09-25 실측 3,598건 = 이번 회차 1,731 + 같은 문서의 중복 적재 800 + 옛 후보 1,067) 기본을 이번 회차로 둔다. 화면에서
# 「전체 배치」로 언제든 바꿀 수 있고, 이 배치가 서버에 없으면 자동으로 전체를 보여 준다.
GOLDEN_DEFAULT_REVIEW_BATCH=expert_review_1731_20260924

# 외부 전문가 블라인드 검수 — 기본값이 꺼짐(False)이라 이 줄이 없으면 검수자 화면에 제안 등급·근거가 그대로 보여
# 독립 판정이 깨진다(오류 없이 조용히 그렇게 됨). setup.sh 가 만드는 .env 는 이미 1 이고, 이 템플릿을 직접 복사해
# 배포해도 같아야 한다. 검수자별로 문서를 나눠 배정하려면 GOLDEN_REVIEWER_ASSIGNMENT_ENFORCED=1 을 따로 켠다.
GOLDEN_REVIEW_BLIND_ENFORCED=1

# --- 골든 검수 콘솔 로그인 (JWT) — .env.onprem-local 과 동일 이유 ---
# 결정 저장 계열은 공유 API_KEY 를 거부하고 포털 JWT 쿠키만 받는다. 비워두면 아무도 로그인 못한다
# (2026-09-24 로컬 재현). JWT_JWKS_PATH 는 golden_data 볼륨(datasets/) 밑이어야 컨테이너가 본다.
# 발급: docker compose ... exec api python scripts/setup_console_test_login.py \
#         --sub <이름> --roles reviewer --also-copy-jwks datasets/_console_jwt/jwks.json
AUTH_MODE=both
JWT_JWKS_PATH=datasets/_console_jwt/jwks.json
JWT_ISSUER=koipa-console
JWT_AUDIENCE=koipa-api
