# ============================================================
# Lloydk PoC — Profile: full-train
# 대상: KOIPA 풀스펙 (GPU 24GB+ · 학습 라우터 활성)
# 외부 API + KURE/BGE 임베딩 + reranker=noop + /api/v1/training/* 노출
# ============================================================

DEPLOY_PROFILE=full-train

# 프로파일 default:
#   LLM_PROVIDER=anthropic
#   EMBEDDING_PROVIDER=hf
#   RERANKER_PROVIDER=noop    (실측 recall 무개선·CPU 5배)
#   VECTOR_BACKEND=pg         (pgvector dense + ts_rank 하이브리드 — ES 폐기)
#   STORAGE_BACKEND=local     (로컬FS, MinIO 미사용 결정 2026-06-24)
#   ENABLE_TRAINING=true        ← 학습 라우터 등록됨
#   POC_MODE=full

# --- 필수 ---
API_KEY=replace_me_api_key
ANTHROPIC_API_KEY=sk-ant-...

# --- 인프라 ---
DATABASE_URL=postgresql+psycopg://lloydk:lloydk_dev@localhost:5432/lloydk
REDIS_URL=redis://localhost:6379/0
# ES·MinIO 미사용 — 프로파일 default 가 vector=pg / storage=local 을 강제한다(위 헤더).
# 아래는 참고용이며 런타임 미사용. ES/MinIO 를 실제로 쓰려면 VECTOR_BACKEND=/STORAGE_BACKEND= 를
# 명시적으로 덮어써야 하나, 폐쇄망 결정(2026-06-24)상 권장하지 않음.
# ES_URL=http://localhost:9200
# ES_PASSWORD=replace_me_es
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=lloydk
# MINIO_SECRET_KEY=replace_me_minio

# --- 모델 ---
LLM_MODEL=claude-sonnet-4-6
CLASSIFIER_BASE_MODEL=kakaobank/kf-deberta-base
EMBEDDING_MODEL=nlpai-lab/KURE-v1
