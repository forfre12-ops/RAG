# ============================================================
# Koipa PoC — Environment Variables
# 복사: cp .env.example .env  (Windows: copy .env.example .env)
# ============================================================

# --- DB / Object Storage ---
POSTGRES_PASSWORD=koipa_dev
MINIO_ROOT_USER=koipa
MINIO_ROOT_PASSWORD=koipa_dev_minio

# --- 인프라 엔드포인트 (로컬 실행 시) ---
# [2026-09-09] **PostgreSQL + pgvector 로 되돌렸다 — MariaDB 는 버렸다**(고객사 요청).
# 9/5 에 MariaDB 로 넘긴 이유는 "KL 포털이 쓰는 DB 가 MariaDB" 였는데 그 전제가 없어졌다.
# 유사문서 조회의 벡터 저장소가 이 DB 안에 들어가므로 이미지는 pgvector 판이어야 한다
# (MariaDB 10.11 에는 벡터 타입이 없다 — 실측 `ERROR 4161 Unknown data type: 'VECTOR'`).
#
#   docker compose up -d postgres && alembic upgrade postgres@head
DATABASE_URL=postgresql+psycopg://koipa:koipa_dev@localhost:5432/koipa
MINIO_ENDPOINT=localhost:9000
REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000

# ============================================================
# LLM 일반화 — 원격/로컬 자유 선택 (W9, 일반화 납품 전제)
# ============================================================
# LLM_PROVIDER 옵션:
#   noop          : 결정론적 mock (CI·dryrun, API 키 불필요)
#   anthropic     : Claude Sonnet/Opus/Haiku 원격 (ANTHROPIC_API_KEY 필요)
#   openai        : GPT-4o 원격 (OPENAI_API_KEY 필요)
#   google        : Gemini 원격 (GOOGLE_API_KEY 필요)
#   local_openai  : OpenAI 호환 로컬 endpoint 일반 (LOCAL_LLM_* 사용)
#   vllm          : (alias) local_openai와 동일 — settings.local_llm_* 기본
#   ollama        : (alias) Ollama OpenAI 호환 endpoint :11434
#   lm_studio     : (alias) LM Studio OpenAI 호환 endpoint :1234
# ============================================================
LLM_PROVIDER=noop
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- 로컬 LLM endpoint (LLM_PROVIDER=local_openai|vllm|ollama|lm_studio 사용 시) ---
# 시나리오 A: vLLM (Qwen3·Llama·Mistral 등)
#   LOCAL_LLM_BASE_URL=http://localhost:8001/v1
#   LOCAL_LLM_MODEL=Qwen/Qwen3-14B
#   LOCAL_LLM_API_KEY=EMPTY
# 시나리오 B: Ollama
#   LOCAL_LLM_BASE_URL=http://localhost:11434/v1
#   LOCAL_LLM_MODEL=qwen3:14b
#   LOCAL_LLM_API_KEY=ollama
# 시나리오 C: LM Studio
#   LOCAL_LLM_BASE_URL=http://localhost:1234/v1
#   LOCAL_LLM_MODEL=<lm-studio model id>
#   LOCAL_LLM_API_KEY=lm-studio
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_MODEL=Qwen/Qwen3-14B
LOCAL_LLM_API_KEY=EMPTY
# Qwen3 thinking mode: true(reasoning ON, slower) / false(fast, recommended for FUN-003 synthesis)
LOCAL_LLM_ENABLE_THINKING=false

# 하위호환 alias (VLLM_*) — 기존 코드·테스트가 참조 중
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen3-14B
VLLM_ENABLE_THINKING=false

# --- API ---
API_KEY=koipa_dev_apikey
# [2026-10-06] 키 교체 유예(rotation grace) — 비워두면 평소처럼 API_KEY 하나만 받는다.
# 채우면 두 값 다 받아준다: 새 키로 호출자를 다 옮긴 뒤 이 값을 다시 비워 옛 키를 폐기.
API_KEY_PREVIOUS=
# api_key(기본) | jwt | both | none. none = X-API-Key·JWT 검증을 전부 생략한다(2026-10-06
# 사용자 결정, 폐쇄망 전용 배포). 역할은 그래도 API_KEY_ROLE 그대로 쓴다. 이 네트워크가
# 외부에 열리면(설정 변경·프록시 추가 등) 그 순간 인증 없이 전체 API 가 열리므로,
# 인터넷에서 닿지 않는 배포에서만 쓸 것 — 일반 배포는 api_key(기본)를 유지한다.
AUTH_MODE=api_key
# api_key 모드에서 부여되는 역할(admin|reviewer|kl_backend|system). require_role 검사 대상.
# auth_mode=none 이어도 이 값은 그대로 역할 상한으로 적용된다(인증 생략≠전권 승인).
# 관리자 콘솔(/demo/admin.html)은 confirm·relabel(admin,reviewer)과
# train·model/reload·keywords(admin)를 호출하므로 system 이면 해당 호출이 전부 403 이다.
# 개발·시연 기본은 admin — 콘솔이 바로 동작해야 학습·리허설이 가능하다.
# 테스트서버는 deploy_testserver_dual.sh 가 admin 을 자동 주입하고,
# 운영 템플릿(.env.prod.example)은 최소권한으로 system 을 유지한다.
API_KEY_ROLE=admin
# 반드시 false. true 면 X-Actor-Role 헤더로 역할 자칭이 가능해진다
# (운영 모드에서는 config.py 가 startup fail-fast 로 차단).
API_KEY_TRUST_ACTOR_ROLE_HEADER=false

# [2026-10-06] KL 요청 — 파일 업로드 대신 "같은 VM에 이미 있는 파일 경로"로 등록.
# 비워두면(기본) 기능이 꺼진다(file_path 를 보내도 422). 채우면 이 디렉터리가 실제로
# 이 컨테이너에 마운트돼 있어야 하고, 그 바깥을 가리키는 경로는 전부 거절한다.
DOCUMENTS_SHARED_MOUNT_DIR=
# POST /documents/batch 한 요청의 최대 파일 수(파일마다 동기 파싱이 필요해서 1000(=/classify/batch)보다 작게 둔다).
DOCUMENTS_BATCH_MAX_FILES=50

# [2026-10-06] KL 요청 — 분류 완료를 koipa:job:{job_id} 저장·콜백 외에 Redis Stream 으로도
# 발사(Consumer Group 직접구독). 비워두면(기본) 앱 기능이 꺼진다. **메인 REDIS_URL 과 반드시
# 다른 인스턴스를 가리킬 것** — docker-compose.airgap.yml 의 redis-kl-stream 서비스 참고.
# 그 컨테이너는 profile(kl-stream) 뒤에 있어 이 값만으로는 안 뜬다 — 설치 시
# `docker compose --profile kl-stream up -d` 를 같이 줘야 한다.
KL_STREAM_REDIS_URL=
KL_STREAM_NAME=koipa:classify:results
KL_STREAM_MAXLEN=10000

# --- 운영 로그 보존기간 (services/retention.py) ---
# 오래된 감사로그·LLM 사용량을 기간으로 지운다. 오래된 파티션을 떼는 코드가 없어
# 두 표가 무한히 자라는 것을 막는 장치다.
#   ⚠ 기본 OFF. 감사로그는 컴플라이언스 기록이라 잘못 켜면 증빙이 사라진다.
#   ⚠ 켜기 전에 반드시: python scripts/purge_retention.py --dry-run --force-enabled
#   0 이하 = 그 표는 보존 무제한(삭제 안 함)
RETENTION_ENABLED=0
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_LLM_USAGE_DAYS=365

# --- DB / worker operational tuning ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
CELERY_RESULT_EXPIRES=86400
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# --- Models ---
CLASSIFIER_BASE_MODEL=kakaobank/kf-deberta-base
# P1 v5_clean/v-fe4b386b (배포 모델 — 2026-07-29 gate_p1_candidate 3축 PASS 승격). 롤백=v4_clean/v-dd3abab9.
# Leave empty only when rule-fallback is intentional.
CLASSIFIER_MODEL_DIR=artifacts/classifier_p1_v5_clean/v-fe4b386b
# 서빙 추론 장치: cpu(기본) | auto | cuda — 설계는 "서빙은 CPU". auto 는 추론 전용 GPU 가 따로 있을 때만.
# ⚠ 학습용 GPU 를 vLLM 등과 나눠 쓰는 서버에서 auto 면 대용량 문서가 CUDA 메모리 부족으로 실패한다(211 실측 2026-09-11).
# CLASSIFIER_DEVICE=cpu
# Korean retrieval: KURE-v1 (BGE-M3 fine-tuned for Korean) is the default. Fallback: BAAI/bge-m3
EMBEDDING_MODEL=nlpai-lab/KURE-v1
RAG_DEFAULT_COLLECTION=docs
RAG_INDEX_CHUNK_SIZE=1200
RAG_INDEX_CHUNK_OVERLAP=100
RAG_OPERATIONAL_EMBEDDING_MODEL=nlpai-lab/KURE-v1
RAG_OPERATIONAL_SEARCH_MODE=hybrid

# --- MinIO 버킷 ---
MINIO_BUCKET_DOCS=koipa-docs
MINIO_BUCKET_MODELS=koipa-models
MINIO_BUCKET_MLFLOW=mlflow

# --- PoC 동작 모드 ---
# dryrun: 무거운 모델 다운로드 없이 mock으로 파이프라인 검증
# full: 실제 모델 로드 (GPU 보유 → CUDA, 미보유 → CPU 추론)
# W9 일반화: GPU 의존성 제거 — 양쪽 환경 모두 운영 가능
POC_MODE=dryrun

# --- 사내 규정 참고 표시 (선택 기능 · 기본 꺼짐) ---
# 회원사가 올린 사내 규정에서 검수 중인 문서와 관련된 원문 문장을 검수 화면에 참고로 보여 준다.
# 등급 판정·자동 확정·검수 라우팅에는 쓰이지 않는다. 기본은 LLM 도 쓰지 않는다(외부 호출 0) — 아래 REGULATION_LLM_SELECT_ENABLED 는 선택 옵션.
# 켜면 콘솔 설정 탭에 「사내 규정(참고 표시)」 카드가 생기고 /api/v1/regulations 가 열린다.
# 끄면 그 화면·API 가 사라진다(올려 둔 규정 데이터는 남는다).
# ⚠ 전제: 문서와 규정을 **같은 실제 임베더**(EMBEDDING_PROVIDER=hf · KURE-v1)로 비교한다.
#   해시 임베더면 규정 등록이 거절되고 기동 로그에 경고가 남는다. 폐쇄망 번들에는 임베더 모델이 들어 있어야 한다.
# ⚠ 규정을 올린 뒤에는 콘솔에서 「미리보기」로 문서마다 어떻게 보이는지 확인하고, 적용 대상 확인을 거쳐 활성화한다.
# REGULATION_REFERENCE_ENABLED=1
# REGULATION_EVIDENCE_MAX_ITEMS=1    # 검수 화면에 보이는 조항 수 (1~3). 결정형은 2번째부터 정밀도가 13% 이하였다. LLM 옵션에서는 LLM 이 해당한다고 고른 조항만 늘고, 둘 이상 고른 문서는 71건 중 3건뿐이다
# REGULATION_MIN_SIMILARITY=0.0      # 0~1. 0 이면 끔
# REGULATION_MAX_SENTENCES=3000      # 규정 한 판의 색인 상한(문장). 넘으면 등록이 실패로 끝난다
# REGULATION_ACTIVE_MAX=5            # 동시에 사용할 수 있는 규정 수(규정명 기준)
# 「해당되는 규정만」 보이게 하는 선택 옵션 — 조회 점수로는 해당 여부를 못 가르므로 **로컬 LLM** 이 후보 조항에서 이 문서에 직접 적용되는 항을 고른다.
#   화면에는 고른 항의 규정 원문만 나가고(LLM 이 만든 글은 안 나간다), 해당 항이 없으면 아무것도 안 보인다. 꺼두면 조회 1위를 그대로 보인다.
#   ⛔ 문서 본문이 프롬프트에 들어가므로 LLM_PROVIDER 가 ollama·vllm·local_openai·lm_studio 일 때만 동작한다(그 밖이면 안 보이고 기동 로그에 경고).
#   ⚠ 비용: 검수자가 「왜 이 등급인가?」를 펼칠 때 후보 수만큼 LLM 을 동시에 부른다(같은 문서는 캐시). GPU 없는 서버는 호출당 수십 초다(Ryzen 7 7800X3D 8코어에서 37.5초).
#     GPU 없이(CPU 만) 쓰면 제품 경로로 잰 문서당 시간이 후보마다 묻기 126~130초 · 한 번에 고르기(REGULATION_LLM_MODE=single) 75~79초다(문서 2건, 이 PC Ryzen 7 7800X3D 8코어).
#     기본 제한 시간 REGULATION_LLM_TIMEOUT_S=60 을 넘어 **아무것도 안 뜬다**(60.0초에 포기 — 확인) — 쓰려면 제한 시간을 늘려야(최대 600) 하고 검수자가 그만큼 기다린다. 검수 화면에서 바로 보여 줄 속도는 아니다.
#     Ollama 를 띄우는 쪽에서 스레드 수를 논리 코어 수(이 PC 는 16)로 올리면 줄어든다 — 모델 파일에 `PARAMETER num_thread 16` 을 주고 그 모델을 LOCAL_LLM_MODEL 로 쓴다: 후보마다 묻기 128 → 104초 · 한 번에 고르기 77 → 65초.
#   ⚠ Ollama 는 놀고 있으면 5분 뒤 모델을 내린다(이 PC 에서 expires_at 이 마지막 호출 +5분인 것을 확인) — 내려간 뒤 첫 호출은 모델 적재 3.7~30초가 붙는다.
#     Ollama 를 띄우는 쪽(이 앱의 .env 가 아니다)에 OLLAMA_KEEP_ALIVE=-1 을 주면 내리지 않는다. vLLM 은 해당 없음.
#   ⛔ 서버 주소도 본다: 공급자 이름이 로컬이어도 LOCAL_LLM_BASE_URL 의 주소가 사내(루프백·사설 IP, 또는 이름을 풀면 사설 IP)가 아니거나 이름이 풀리지 않으면 문서를 보내지 않는다(reason=llm_not_local, 기동 로그에 경고).
#   ⚠ LLM 서버 위치: LLM_PROVIDER=ollama·lm_studio 는 이 서버의 localhost 로 고정이다(LOCAL_LLM_BASE_URL 을 무시한다). 같은 폐쇄망의 다른 GPU 서버를 쓰려면 LLM_PROVIDER=vllm(또는 local_openai) +
#     LOCAL_LLM_BASE_URL=http://<GPU 호스트>:8001/v1. ⚠ 이 옵션의 측정(정밀도·시간)은 전부 Ollama+qwen3:14b 로 했다 — vLLM(운영 경로)에서는 재지 않았다.
#   ⚠ 호출 한도: 호출 하나의 시간 초과 = REGULATION_LLM_TIMEOUT_S, 재시도 없음(이 기능의 호출만 — 다른 기능의 LLM 호출은 그대로). 결과 캐시와 동시 호출 상한은 API 프로세스(워커)마다 따로다 — 워커가 여럿이면
#     같은 문서가 워커마다 다른 판정을 보일 수 있다(온도 0 이어도 경계 문서는 실행마다 바뀐다). 폐쇄망 compose(airgap·prod)는 워커 1개(WEB_CONCURRENCY=1), Dockerfile 단독 실행 기본은 4개다.
#   ⚠ REGULATION_LLM_DOC_CHARS 를 올리면 프롬프트가 모델 컨텍스트를 넘을 수 있다(Ollama 는 넘치는 앞부분을 잘라 넣는다 — 문서를 못 본 채 고르게 된다). 기본 1500 을 권한다.
#     한 번에 고르기(single)는 후보 조항의 항을 프롬프트에 **최대 80개**까지 싣는다(뒤 후보는 빠진다). 후보마다 묻기는 조항의 항을 전부 싣는다.
# REGULATION_LLM_SELECT_ENABLED=1
# REGULATION_LLM_CANDIDATES=5        # 조회 순위 상위 몇 개 조항을 LLM 에게 물을지 (1~10)
# REGULATION_LLM_DOC_CHARS=1500      # 프롬프트에 넣는 문서 앞부분 글자 수 (300~6000)
# REGULATION_LLM_TIMEOUT_S=60        # 문서 하나의 판정 제한 시간(초, 1~600) — 넘으면 안 보인다(GPU 없이 CPU 만이면 60초를 넘는다). 호출 하나의 한도이기도 하다. 동봉 프록시(nginx)가 경로에 있으면 300초에서 잘린다
# REGULATION_LLM_MAX_CONCURRENCY=6   # 프로세스 안에서 동시에 나가는 LLM 호출 수 (1~32) — 한 문서의 후보 5개 + 문서 종류 확인 1개
# REGULATION_LLM_CACHE_TTL_S=3600    # 같은 문서·규정 판·모델의 결과를 기억하는 시간(초, 0 = 기억 안 함)
# REGULATION_LLM_SKIP_PUBLIC=1       # 문서가 이미 공개된 외부 자료(판결문·법령·보도·공시)이면 아무것도 안 보인다(기본 켜짐, 호출 하나가 더 든다)
# REGULATION_LLM_MODE=per_candidate  # 고르는 방식(같은 71건·판정자 3명 기준). per_candidate(기본) = 후보 조항마다 따로 묻는다 — 정밀도 78% · 해당 규정이 뜬 문서 14 · 틀린 규정이 뜬 문서 4 · 호출 6번 · 문서당 약 2.9초
#                                    #   single = 문서를 한 번만 보이고 가장 직접적인 항을 고르게 한다 — 정밀도 70% · 해당 30 · 틀린 것 13 · 호출 2번 · 문서당 약 1.1초(GPU). 더 많이 찾는 대신 틀린 것도 더 뜬다
