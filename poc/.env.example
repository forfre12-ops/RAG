# ============================================================
# Lloydk PoC — Environment Variables
# 복사: cp .env.example .env  (Windows: copy .env.example .env)
# ============================================================

# --- DB / Object Storage ---
POSTGRES_PASSWORD=lloydk_dev
MINIO_ROOT_USER=lloydk
MINIO_ROOT_PASSWORD=lloydk_dev_minio

# --- 인프라 엔드포인트 (로컬 실행 시) ---
DATABASE_URL=postgresql+psycopg://lloydk:lloydk_dev@localhost:5432/lloydk
MINIO_ENDPOINT=localhost:9000
REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000

# --- 벡터 DB 백엔드 (es | inmemory) ---
# es      : Elasticsearch 8.14+ (기본, dense_vector + BM25 + RRF 하이브리드)
# inmemory: dryrun 폴백 (테스트 강제 inmemory는 force_memory=True)
VECTOR_BACKEND=es
ES_URL=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=lloydk_dev_es
ES_API_KEY=
ES_VERIFY_CERTS=true

# --- LLM provider (anthropic | openai | google | vllm | ollama | noop) ---
# noop: API 키 없이 결정론적 더미 응답 — 파이프라인 검증용
LLM_PROVIDER=noop
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# vLLM endpoint (when LLM_PROVIDER=vllm) — requires vLLM >= 0.8.5 for Qwen3
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen3-14B
# Qwen3 thinking mode: true(reasoning ON) / false(fast generation, recommended for FUN-003 synthesis)
VLLM_ENABLE_THINKING=false

# --- API ---
API_KEY=lloydk_dev_apikey

# --- Models ---
CLASSIFIER_BASE_MODEL=kakaobank/kf-deberta-base
# Korean retrieval: KURE-v1 (BGE-M3 fine-tuned for Korean) is the default. Fallback: BAAI/bge-m3
EMBEDDING_MODEL=nlpai-lab/KURE-v1

# --- MinIO 버킷 ---
MINIO_BUCKET_DOCS=lloydk-docs
MINIO_BUCKET_MODELS=lloydk-models
MINIO_BUCKET_MLFLOW=mlflow

# --- PoC 동작 모드 ---
# dryrun: 무거운 모델 다운로드 없이 mock으로 파이프라인 검증
# full: 실제 모델 로드 (GPU/대용량 VRAM 필요)
POC_MODE=dryrun
