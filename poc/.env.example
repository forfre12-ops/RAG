# ============================================================
# Lloydk PoC — Environment Variables
# 복사: cp .env.example .env  (Windows: copy .env.example .env)
# ============================================================

# --- DB / Object Storage ---
POSTGRES_PASSWORD=lloydk_dev
MINIO_ROOT_USER=lloydk
MINIO_ROOT_PASSWORD=lloydk_dev_minio

# --- 인프라 엔드포인트 (로컬 실행 시) ---
DATABASE_URL=postgresql+psycopg://lloydk:lloydk_dev@localhost:5432/lloydk
MINIO_ENDPOINT=localhost:9000
REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000

# --- 벡터 DB 백엔드 (pg | es | inmemory) ---
# pg      : Postgres pgvector dense + bigram-tsvector ts_rank 하이브리드 (기본, 의사결정_대장 §03 ⓑ)
#           DATABASE_URL 의 PG 가 pgvector 확장 보유 + alembic upgrade head 필요.
# es      : Elasticsearch (레거시 — elasticsearch 패키지 별도 설치 시에만)
# inmemory: dryrun 폴백 (테스트 강제 inmemory는 force_memory=True)
VECTOR_BACKEND=pg

# ============================================================
# LLM 일반화 — 원격/로컬 자유 선택 (W9, 일반화 납품 전제)
# ============================================================
# LLM_PROVIDER 옵션:
#   noop          : 결정론적 mock (CI·dryrun, API 키 불필요)
#   anthropic     : Claude Sonnet/Opus/Haiku 원격 (ANTHROPIC_API_KEY 필요)
#   openai        : GPT-4o 원격 (OPENAI_API_KEY 필요)
#   google        : Gemini 원격 (GOOGLE_API_KEY 필요)
#   local_openai  : OpenAI 호환 로컬 endpoint 일반 (LOCAL_LLM_* 사용)
#   vllm          : (alias) local_openai와 동일 — settings.local_llm_* 기본
#   ollama        : (alias) Ollama OpenAI 호환 endpoint :11434
#   lm_studio     : (alias) LM Studio OpenAI 호환 endpoint :1234
# ============================================================
LLM_PROVIDER=noop
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- 로컬 LLM endpoint (LLM_PROVIDER=local_openai|vllm|ollama|lm_studio 사용 시) ---
# 시나리오 A: vLLM (Qwen3·Llama·Mistral 등)
#   LOCAL_LLM_BASE_URL=http://localhost:8001/v1
#   LOCAL_LLM_MODEL=Qwen/Qwen3-14B
#   LOCAL_LLM_API_KEY=EMPTY
# 시나리오 B: Ollama
#   LOCAL_LLM_BASE_URL=http://localhost:11434/v1
#   LOCAL_LLM_MODEL=qwen3:14b
#   LOCAL_LLM_API_KEY=ollama
# 시나리오 C: LM Studio
#   LOCAL_LLM_BASE_URL=http://localhost:1234/v1
#   LOCAL_LLM_MODEL=<lm-studio model id>
#   LOCAL_LLM_API_KEY=lm-studio
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_MODEL=Qwen/Qwen3-14B
LOCAL_LLM_API_KEY=EMPTY
# Qwen3 thinking mode: true(reasoning ON, slower) / false(fast, recommended for FUN-003 synthesis)
LOCAL_LLM_ENABLE_THINKING=false

# 하위호환 alias (VLLM_*) — 기존 코드·테스트가 참조 중
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen3-14B
VLLM_ENABLE_THINKING=false

# --- API ---
API_KEY=lloydk_dev_apikey
AUTH_MODE=api_key
API_KEY_ROLE=system
API_KEY_TRUST_ACTOR_ROLE_HEADER=false

# --- DB / worker operational tuning ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
CELERY_RESULT_EXPIRES=86400
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# --- Models ---
CLASSIFIER_BASE_MODEL=kakaobank/kf-deberta-base
# P1 v4_clean/v-dd3abab9 (배포 모델). 2026-06-03 디오염 홀드아웃 정직평가(v3 0.830=train-on-test 오염 폐기).
# 정직 FNR 0.056 / F1 0.634(<KPI 0.75). Leave empty only when rule-fallback is intentional.
CLASSIFIER_MODEL_DIR=artifacts/classifier_p1_retrain_v4_clean/v-dd3abab9
# Korean retrieval: KURE-v1 (BGE-M3 fine-tuned for Korean) is the default. Fallback: BAAI/bge-m3
EMBEDDING_MODEL=nlpai-lab/KURE-v1
RAG_DEFAULT_COLLECTION=docs
RAG_INDEX_CHUNK_SIZE=1200
RAG_INDEX_CHUNK_OVERLAP=100
RAG_OPERATIONAL_EMBEDDING_MODEL=nlpai-lab/KURE-v1
RAG_OPERATIONAL_SEARCH_MODE=hybrid

# --- MinIO 버킷 ---
MINIO_BUCKET_DOCS=lloydk-docs
MINIO_BUCKET_MODELS=lloydk-models
MINIO_BUCKET_MLFLOW=mlflow

# --- PoC 동작 모드 ---
# dryrun: 무거운 모델 다운로드 없이 mock으로 파이프라인 검증
# full: 실제 모델 로드 (GPU 보유 → CUDA, 미보유 → CPU 추론)
# W9 일반화: GPU 의존성 제거 — 양쪽 환경 모두 운영 가능
POC_MODE=dryrun
