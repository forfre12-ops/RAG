# [재현성] base image digest 고정 (Dockerfile.api.prod 와 동일 digest 유지).
# 갱신: docker buildx imagetools inspect python:3.11-slim
FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# 워커는 classify/index 태스크에서 문서를 파싱한다 → api 와 동일한 OS 파서 바이너리 필요
# (없으면 HWP/PDF 파싱이 무성 실패). libfreetype6(rhwp LD_PRELOAD)만 유지 — OCR(tesseract/poppler=GPL)은 배포 제외.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential libpq-dev libfreetype6 libexpat1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# [재현성] uv.lock 동봉 — api.prod 와 동일 규약(scripts/docker_install_locked.sh).
COPY pyproject.toml uv.lock ./
COPY src ./src
COPY scripts ./scripts
# [이미지 크기] torch 를 먼저 명시 인덱스로 깐다 — 안 하면 pip 이 PyPI 기본(CUDA) 휠을 끌어와
# nvidia 런타임 패키지만 2.7GB, 이미지가 9.9GB 가 된다(api.prod=CPU 3.4GB 와 대비). 고객사
# 운영노드는 CPU 전용이라 그 2.7GB 는 전부 사표(死票)다. 기본값 CPU 는 Dockerfile.api.prod 와
# 동일 규약이며, GPU 학습 노드(지재원)는 빌드 때 인덱스를 넘겨 CUDA 휠로 만든다:
#   docker build --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu124 -f Dockerfile.worker .
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu

# 파싱 글루(hwp/hwp-tables/xls) 포함 — 워커가 무성 파싱 실패하지 않도록(api.prod 와 동일 extras).
# [hwp-tables] unhwp(MIT) — 배치 경로도 .hwp 표 셀을 회수해야 API 경로와 등급이 일치한다.
# [xls] xlrd 누락 시 구형 .xls 가 0글자로 추출됨(511dbfb 배치경로 재발 방지).
# [라이선스] OCR([ocr], GPL poppler)은 요건 외라 배포 이미지에서 제외(코드·extra 정의만 리포 존치).
# 2026-08-02: dev(Dockerfile.api)·에어갭 번들에서도 동일 제거 — 전 빌드 경로가 GPL-free.
# [재현성] api.prod 와 동일하게 uv.lock 고정 설치. 워커와 api 가 다른 버전으로 돌면
# 같은 문서가 경로에 따라 다른 등급을 받을 수 있다 — 두 이미지의 의존성은 한 lock 에서 나와야 한다.
RUN pip install --upgrade pip && \
    TORCH_INDEX=${TORCH_INDEX} bash ./scripts/docker_install_locked.sh \
        hwp hwp-tables pdf-tables xls

# [HWP 파싱 복구 — Dockerfile.api.prod 와 동일] rhwp-python 번들 FreeType 에 FT_Palette_Data_Get
# 심볼이 없어 `import rhwp` 가 undefined symbol 로 실패 → .hwp/.hwpx 배치 파싱이 0글자로 깨진다.
# 심볼이 있는 시스템 FreeType(libfreetype6 — apt 로 명시 설치)를 LD_PRELOAD 로 먼저 로드해 채운다.
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libfreetype.so.6

# 비-root 사용자 (보안 하드닝 — Dockerfile.api.prod 와 동일 uid1000). HF 캐시는 non-root 홈에.
# api.prod 와 동일하게 named 볼륨 마운트 지점을 미리 만들어 uid1000 소유로 둔다. Docker 는
# **먼저 마운트하는 컨테이너의 이미지**로 빈 볼륨을 초기화하므로, worker 가 api 보다 먼저 뜨면
# 이 디렉터리가 없어 볼륨이 root 소유로 굳는다(그 뒤 양쪽 다 write 거부).
RUN useradd -m -u 1000 lloydk && mkdir -p /app/.storage /app/datasets && chown -R lloydk:lloydk /app
USER lloydk
ENV HF_HOME=/home/lloydk/.cache/huggingface

CMD ["celery", "-A", "lloydk.workers.celery_app", "worker", "--loglevel=info", "-Q", "classify,index,synthesis,learning"]
