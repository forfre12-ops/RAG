# P2-D4: 운영 프로파일 — uvicorn workers + gunicorn + graceful shutdown.
# 목적: 진정한 병렬 요청 처리 (S11.5 ≥0.5 도달).
#
# 빌드:
#   docker build -f Dockerfile.api.prod -t lloydk-api:prod .
# 실행 (단일 인스턴스):
#   docker run -p 8000:8000 -e WEB_CONCURRENCY=4 lloydk-api:prod
# 멀티 인스턴스:
#   docker-compose 또는 k8s에서 replicas + HPA

FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # 운영 default — env로 override 가능
    WEB_CONCURRENCY=4 \
    UVICORN_TIMEOUT_KEEP_ALIVE=30 \
    GUNICORN_TIMEOUT=60

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential libpq-dev curl libreoffice-core libreoffice-writer \
      tesseract-ocr tesseract-ocr-kor poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --upgrade pip && \
    pip install -e ".[psh,otel,jwt]" gunicorn

COPY src ./src
COPY scripts ./scripts

# 비-root 사용자 (보안)
RUN useradd -m -u 1000 lloydk && chown -R lloydk:lloydk /app
USER lloydk

EXPOSE 8000

# gunicorn + uvicorn worker — 진정한 병렬 처리
# - workers: WEB_CONCURRENCY (CPU 코어 × 2 + 1 권장)
# - worker-class: uvicorn.workers.UvicornWorker
# - timeout: GUNICORN_TIMEOUT (긴 요청 대비)
# - graceful: SIGTERM 시 진행 중 요청 완료까지 대기
CMD ["sh", "-c", "exec gunicorn lloydk.api.app:app \
    --bind 0.0.0.0:8000 \
    --workers ${WEB_CONCURRENCY} \
    --worker-class uvicorn.workers.UvicornWorker \
    --timeout ${GUNICORN_TIMEOUT} \
    --keep-alive ${UVICORN_TIMEOUT_KEEP_ALIVE} \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile -"]
