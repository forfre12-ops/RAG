# P2-D4: 운영 프로파일 — uvicorn workers + gunicorn + graceful shutdown.
# 목적: 진정한 병렬 요청 처리 (S11.5 ≥0.5 도달).
#
# 빌드:
#   docker build -f Dockerfile.api.prod -t lloydk-api:prod .
# 실행 (단일 인스턴스):
#   docker run -p 8000:8000 -e WEB_CONCURRENCY=4 lloydk-api:prod
# 멀티 인스턴스:
#   docker-compose 또는 k8s에서 replicas + HPA

# [재현성] base image 를 digest 로 고정 — 태그(3.11-slim)는 재빌드 시 다른 이미지를 가리킬 수 있어
# 폐쇄망 반입본과 재빌드본의 동일성을 보증하지 못한다. 갱신 시:
#   docker buildx imagetools inspect python:3.11-slim   # → Digest 를 아래에 반영
FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93 AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # 운영 default — env로 override 가능
    WEB_CONCURRENCY=4 \
    UVICORN_TIMEOUT_KEEP_ALIVE=30 \
    GUNICORN_TIMEOUT=60

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential libpq-dev curl libfreetype6 libexpat1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# editable 설치는 패키지 소스(src/)가 있어야 한다(pyproject egg_base=src). pyproject 만 복사한 뒤
# pip install -e 하면 'src does not exist' 로 빌드 실패 → 소스를 먼저 복사한다. alembic/alembic.ini
# 도 복사해야 이 이미지로 `alembic upgrade head`(마이그레이션)를 돌릴 수 있다.
COPY pyproject.toml ./
COPY src ./src
COPY scripts ./scripts
COPY alembic ./alembic
COPY alembic.ini ./
# torch 변형: 기본 CPU 전용(테스트·CPU 고객사) — CUDA 라이브러리(nvidia-cu*·triton, ~7GB)를 빼
# 이미지를 ~10GB → ~3GB 로 줄인다. CPU 서버에선 CUDA torch 가 순수 낭비(추론은 CPU 로 동작).
# 지재원 GPU 서버는 빌드 시 override:
#   docker build --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu124 -f Dockerfile.api.prod .
# torch 를 먼저 CPU 인덱스에서 깔아두면, 이어지는 editable 설치의 torch>=2.3 제약이 이미 충족돼
# PyPI 기본(CUDA) 휠을 다시 끌어오지 않는다.
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
# extras: 운영(psh 성능·otel 관측·jwt) + 파싱 의존(hwp·hwp-tables·xls) — 파싱 요건(FUN) 유지.
# [hwp-tables] unhwp(MIT). rhwp 는 .hwp 바이너리의 표 셀을 통째로 흘려 표 안의 등급·원가·
# 담당 정보가 분류기에 안 보인다(=조용한 미탐). 구 pyhwp(AGPL) 대체 — 반출본에 AGPL 없음.
# [라이선스] OCR([ocr]=pytesseract/pdf2image+poppler-utils=GPL)은 요건 외(FUN-022=전자문서 텍스트추출뿐)라
# 배포 이미지에서 제외 → GPL(poppler) 반출 소거. 2026-08-02 부터 dev(Dockerfile.api)·워커·에어갭
# 번들도 동일하게 OCR 미포함 — 어느 이미지로 빌드해도 GPL 이 반출되지 않는다. OCR 코드·[ocr] extra
# 정의만 리포에 존치(요건화 시 재활성). 스캔 PDF 는 본문 0자 → processing_status='failed' 격리.
RUN pip install --upgrade pip && \
    pip install --index-url ${TORCH_INDEX} "torch>=2.3" && \
    pip install -e ".[psh,otel,jwt,hwp,hwp-tables,pdf-tables,xls]" gunicorn && \
    pip install -U "wheel>=0.46.2" "jaraco.context>=6.1.0"   # [보안] Trivy 유일 수정가능 2건(빌드툴 CVE) 상향

# [HWP 파싱 복구] rhwp-python 이 번들한 FreeType(libfreetype-*.so.6)에 FT_Palette_Data_Get 심볼이
# 없어 `import rhwp` 가 undefined symbol 로 실패 → .hwp/.hwpx 추출이 0글자로 깨진다. 심볼이 있는
# 시스템 FreeType(libfreetype6 — apt 로 명시 설치)를 LD_PRELOAD 로 먼저 로드해 심볼을 채운다.
# (libreoffice 는 문서변환에 코드가 한 번도 호출하지 않아 제거 — perl 등 CRITICAL CVE 다수 동반 제거, 배포감사)
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libfreetype.so.6

# 비-root 사용자 (보안)
# /app/.storage · /app/datasets 를 미리 만들어 uid1000 소유로 둔다 — named 볼륨이 첫 마운트 때
# 이 빈 디렉터리 소유권을 물려받아(Docker 볼륨 초기화) 비-root 가 바로 쓸 수 있다(없으면 root
# 소유로 생성돼 write 거부). datasets 는 골든 후보 산출 경로이고 .dockerignore 라 이미지에
# 내용이 없으므로, 이 mkdir 이 없으면 prod 프로파일에서 골든 빌드가 Permission denied 로
# 죽는다(2026-08-02 prod 프로파일 실측에서 재현).
RUN useradd -m -u 1000 lloydk && mkdir -p /app/.storage /app/datasets && chown -R lloydk:lloydk /app
USER lloydk

EXPOSE 8000

# gunicorn + uvicorn worker — 진정한 병렬 처리
# - workers: WEB_CONCURRENCY (CPU 코어 × 2 + 1 권장)
# - worker-class: uvicorn.workers.UvicornWorker
# - timeout: GUNICORN_TIMEOUT (긴 요청 대비)
# - graceful: SIGTERM 시 진행 중 요청 완료까지 대기
CMD ["sh", "-c", "exec gunicorn lloydk.api.app:app \
    --bind 0.0.0.0:8000 \
    --workers ${WEB_CONCURRENCY} \
    --worker-class uvicorn.workers.UvicornWorker \
    --timeout ${GUNICORN_TIMEOUT} \
    --keep-alive ${UVICORN_TIMEOUT_KEEP_ALIVE} \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile -"]
