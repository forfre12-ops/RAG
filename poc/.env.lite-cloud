# ============================================================
# Lloydk PoC — Profile: lite-cloud
# 대상: GPU 없음, 외부 LLM API 사용 (가장 일반적 SaaS형 납품)
# Anthropic Claude 또는 OpenAI GPT-4o로 LLM, KURE 임베딩은 CPU
# ============================================================

DEPLOY_PROFILE=lite-cloud

# 프로파일 default:
#   LLM_PROVIDER=anthropic   (또는 LLM_PROVIDER=openai)
#   EMBEDDING_PROVIDER=hf
#   RERANKER_PROVIDER=noop
#   VECTOR_BACKEND=pg         (ES 제거됨 — pgvector dense + ts_rank 하이브리드)
#   STORAGE_BACKEND=minio
#   ENABLE_TRAINING=false
#   POC_MODE=full             (→ 아래 자격증명이 없으면 startup fail-fast)

# --- 필수 자격증명 (poc_mode=full startup 검증 대상 — 없으면 부팅 거부) ---
API_KEY=replace_me_api_key
ANTHROPIC_API_KEY=sk-ant-...
# 또는
# OPENAI_API_KEY=sk-...
# 감사체인 HMAC 비밀키 (NFR-SEC-01) — 미설정 시 부팅 거부. 생성: openssl rand -hex 32
LLOYDK_AUDIT_CHAIN_SECRET=replace_me_audit_chain_secret_openssl_rand_hex_32
# CORS — 운영은 "*" 금지(부팅 거부). 클라우드 프런트/포털 origin 명시.
# ⚠️ 배포 경로(docker-compose.prod.yml)에서는 CORS_ALLOW_ORIGINS 를 ["${ALLOWED_ORIGIN}"] 로
#    강제 치환한다(environment > env_file) → 실효 노브는 ALLOWED_ORIGIN. deploy_cloud.sh 는
#    ALLOWED_ORIGIN(없으면 CORS_ALLOW_ORIGINS 에서 추출)을 검증·주입한다. 아래 CORS_ALLOW_ORIGINS
#    단독값은 base compose(prod overlay 미사용) 경로에서만 유효.
ALLOWED_ORIGIN=https://replace_me_host
CORS_ALLOW_ORIGINS=["https://replace_me_host"]

# --- 분류 모델 (FUN-004/005) ---
# 컨테이너 내 경로. artifacts/ 는 이미지·git 밖이라 prod_artifacts 볼륨/마운트로 공급해야 한다
# (docs/CLOUD_DEPLOY_RUNBOOK.md §모델 참조). 설정했는데 경로 부재면 **부팅 거부**(무음 rule-fallback
# 방지). 모델 없이 룰만으로 테스트하려면 이 줄을 주석 처리(그 경우 ServingRuleFallbackActive 경보).
CLASSIFIER_MODEL_DIR=/app/artifacts/classifier_p1_retrain_v4_clean/v-dd3abab9
# 온도 보정 (미보정 T=1.0 → OOD 과신·TS/S1 무음미탐). 모델 dir 에 temperature.json 이 있으면
# 자동 로드; 없으면 아래로 대체(권장 T≈3, 사전 실측). 배포 전 calibrate_classifier.py 로 확정 권장.
CLASSIFIER_TEMPERATURE=3.0

# --- 인프라 (docker compose 서비스명으로 연결) ---
# ⚠️ 컨테이너 내부에서 localhost 는 '자기 자신'이라 DB/Redis 에 못 붙는다. 반드시 compose
#    서비스명(postgres/redis/minio)을 쓸 것. 배포 경로(docker-compose.prod.yml)는 base 의
#    DATABASE_URL/REDIS_URL 을 !override 로 제거하므로(worker/beat 는 빈 environment) 이 env
#    값이 유일한 연결 소스다. DATABASE_URL 의 비밀번호는 POSTGRES_PASSWORD(compose postgres
#    초기화값)와 반드시 일치시킬 것.
POSTGRES_PASSWORD=lloydk_dev
DATABASE_URL=postgresql+psycopg://lloydk:lloydk_dev@postgres:5432/lloydk
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=lloydk
MINIO_SECRET_KEY=replace_me_minio

# --- 모델 ---
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=nlpai-lab/KURE-v1
