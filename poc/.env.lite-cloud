# ============================================================
# Lloydk PoC — Profile: lite-cloud
# 대상: GPU 없음, 외부 LLM API 사용 (가장 일반적 SaaS형 납품)
# Anthropic Claude 또는 OpenAI GPT-4o로 LLM, KURE 임베딩은 CPU
# ============================================================

DEPLOY_PROFILE=lite-cloud

# 프로파일 default:
#   LLM_PROVIDER=anthropic   (또는 LLM_PROVIDER=openai)
#   EMBEDDING_PROVIDER=hf
#   RERANKER_PROVIDER=noop
#   VECTOR_BACKEND=es
#   STORAGE_BACKEND=minio
#   ENABLE_TRAINING=false
#   POC_MODE=full

# --- 필수 자격증명 ---
API_KEY=replace_me_api_key
ANTHROPIC_API_KEY=sk-ant-...
# 또는
# OPENAI_API_KEY=sk-...

# --- 인프라 ---
DATABASE_URL=postgresql+psycopg://lloydk:lloydk_dev@localhost:5432/lloydk
REDIS_URL=redis://localhost:6379/0
ES_URL=http://localhost:9200
ES_PASSWORD=replace_me_es

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=lloydk
MINIO_SECRET_KEY=replace_me_minio

# --- 모델 ---
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=nlpai-lab/KURE-v1
