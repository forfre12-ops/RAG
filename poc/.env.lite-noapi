# ============================================================
# Koipa PoC — Profile: lite-noapi
# 대상: GPU·외부 API 모두 없음 (PoC·교육·미공개망 최소 가동)
# 부팅 즉시 가동, 외부 호출 0, 데이터 영속화 없음
# ============================================================

DEPLOY_PROFILE=lite-noapi

# 프로파일 default가 채우는 항목 (env로 override 가능):
#   LLM_PROVIDER=noop
#   EMBEDDING_PROVIDER=hash
#   RERANKER_PROVIDER=noop
#   VECTOR_BACKEND=inmemory
#   STORAGE_BACKEND=local
#   ENABLE_TRAINING=false
#   POC_MODE=dryrun

# --- API 인증 (dryrun 디폴트 빈값, 운영시 명시) ---
API_KEY=

# --- (선택) PG/ES 사용 시 채움 — 미설정 시 inmemory 폴백 ---
# DATABASE_URL=postgresql+psycopg://koipa:koipa_dev@localhost:5432/koipa
# ES_URL=http://localhost:9200
