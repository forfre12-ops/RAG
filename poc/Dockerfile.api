# [재현성] base image digest 고정 (Dockerfile.api.prod 와 동일 digest 유지).
# 갱신: docker buildx imagetools inspect python:3.11-slim
FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

# [빌드 신원] 배포된 이미지가 어느 커밋에서 나왔는지를 런타임이 말할 수 있어야 한다.
# 없으면 "서버가 그 SHA 를 실제로 실행 중인가" 를 확인할 방법이 없고, 릴리스 게이트의
# --expect-git-sha 검증도 공중에 뜬다(실측 2026-08-15: healthz 에 sha 0건).
ARG KOIPA_BUILD_SHA=unknown
ARG KOIPA_BUILD_AT=unknown
ENV KOIPA_BUILD_SHA=${KOIPA_BUILD_SHA} KOIPA_BUILD_AT=${KOIPA_BUILD_AT}

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# [라이선스] OCR OS 바이너리(poppler-utils=GPL, tesseract-ocr)는 설치하지 않는다. OCR 은 요건
# 외(FUN-022=전자문서 텍스트추출뿐)이고, dev 이미지로 반출본을 빌드하는 사고를 막으려면 dev/prod
# 가 동일하게 GPL-free 여야 한다. libfreetype6(rhwp LD_PRELOAD)·libexpat1 만 유지.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential libpq-dev curl libfreetype6 libexpat1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# [재현성] uv.lock 동봉 — api.prod·worker 와 동일 규약(scripts/docker_install_locked.sh).
COPY pyproject.toml uv.lock ./
COPY src ./src
COPY scripts ./scripts
# alembic 마이그레이션 동봉 — 폐쇄망에서 `docker compose run --rm api alembic upgrade head` 실행 가능
COPY alembic ./alembic
COPY alembic.ini ./
# extras 동봉 — Python 글루가 빠지면 HWP/JWT/xls 가 무성으로 동작하지 않는다:
#   [hwp]=rhwp-python (.hwp/.hwpx), [jwt]=PyJWT+cryptography (운영 JWT 인증),
#   [xls]=xlrd (구형 .xls, 511dbfb 재발 방지).
#   [hwp-tables] unhwp(MIT) — .hwp 표 셀 회수. rhwp 단독은 표를 통째로 흘린다(FUN-022 갭).
# 의도적 제외: [ocr](요건 외 + poppler=GPL), [pdf-agpl](PyMuPDF=AGPL, 기본은 pdfminer.six).
# → api.prod/worker 와 동일한 파싱 extras. 스캔 PDF 는 본문 0자 → processing_status='failed' 격리.
# [재현성] uv.lock 고정 설치 — api.prod·worker 와 같은 잠금에서 나온다. dev 이미지가 다른
# 버전으로 돌면 여기서 재현한 결함이 배포본에서 재현되지 않는다.
# ⚠ 종전에는 torch 를 인덱스 지정 없이 전이 의존으로 받아 PyPI 기본(CUDA) 휠이 깔렸다.
# api.prod·worker 와 동일하게 기본 CPU 로 맞춘다(GPU 필요 시 --build-arg TORCH_INDEX 로 override).
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
RUN pip install --upgrade pip && \
    TORCH_INDEX=${TORCH_INDEX} bash ./scripts/docker_install_locked.sh \
        hwp hwp-tables pdf-tables jwt xls

# [HWP 파싱 복구 — Dockerfile.api.prod 와 동일] rhwp 번들 FreeType 의 undefined symbol
# (FT_Palette_Data_Get) 로 `import rhwp` 가 깨지는 것을 시스템 FreeType 선로드로 채운다.
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libfreetype.so.6

EXPOSE 8000
CMD ["uvicorn", "koipa.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
