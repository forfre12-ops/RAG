# [2026-10-07 KL 요청] 고객사 PC 배포 전용 — 문서 분류 + 야간 증분 재학습만 담는다.
#
# 왜: Dockerfile.api.prod(지재원·개발 겸용) 이미지 안에는 문서 분류 코드와 함께 합성 문서
# 생성(FUN-003) 코드가 전부 같이 들어 있었다. app.py 가 enable_synthetic_generation 설정값으로
# 그 라우터를 안 열 수는 있지만(1차 방어선), 코드 자체는 여전히 이미지 안에 물리적으로
# 존재했다 — KL 지적(10/7): "사용자 PC 에 배포될 문서 분류 엔진과 지재원 GPU 서버에 배포될
# 문서 생성 기능은 분리가 되어야 한다."
#
# [2026-10-07 조사로 좁힌 범위] KL 요청은 "검수 화면·생성·학습" 셋을 묶어 말했지만, 실제로
# 파일 단위로 뺄 수 있는 건 **합성 문서 생성뿐**이다.
#   · 골든셋 검수·서명 화면(golden.py·golden_build_service.py·golden_signoff.py·
#     console_signoff.py 등)은 빼지 않는다 — 고객사도 야간 증분 재학습본을 켜려면 사람
#     서명이 적힌 평가셋(locked_eval)이 필요하고, 그 서명을 만드는 화면이 바로 이거다
#     (admin.html applyProfileVisibility 주석, 2026-08-24 결정 — 지우면 고객사가 모델을
#     켤 때마다 force 우회를 영구히 써야 한다). 사용자 확인(2026-10-07): "남긴다".
#   · api/training.py·services/training_service.py 도 빼지 않는다 — 고객사가 쓰는 야간
#     증분 재학습(enable_incremental_retrain)의 공유 코드다.
#   · 지재원 전용 전체학습·URGENT 자동재학습(enable_training 단독 게이트)은 고객사가 쓰는
#     야간 증분 재학습과 workers/tasks.py 안에 같은 파일로 섞여 있어 파일 단위로 뺄 수 없다
#     (Explore 트레이스로 확인) — 기존 enable_training 플래그 게이트가 유일한 분리선이고,
#     이미 정확히 걸려 있다.
#
# 이 Dockerfile은 Dockerfile.api.prod 와 베이스·설치 과정이 전부 같고, 딱 한 단계만
# 다르다 — src 복사 직후 합성 생성 전용 모듈을 지운다(목록은 deploy_manifest.toml 의
# container.customer_exclude 가 정본, 아래 블록은 check_deploy_manifest.py --write 가 생성).
# 실제 import 그래프로 구했다 — grep 으로 찾으면 런타임 import 를 놓친다(2026-10-03 ops
# 이미지 분리 때 실제로 겪은 문제, 그때 교훈 재사용).
#
# 빌드:
#   docker build -f Dockerfile.api.customer -t koipa-api-customer:1.0.0-rc1 .
#
# 지재원/개발용 전체 이미지는 그대로 Dockerfile.api.prod 를 쓴다 — 이 파일은 고객사 전용
# 추가 옵션이고, 기존 지재원 설치 경로는 아무것도 바뀌지 않는다.

FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93 AS base

ARG KOIPA_BUILD_SHA=unknown
ARG KOIPA_BUILD_AT=unknown
ENV KOIPA_BUILD_SHA=${KOIPA_BUILD_SHA} \
    KOIPA_BUILD_AT=${KOIPA_BUILD_AT}
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    WEB_CONCURRENCY=4 \
    UVICORN_TIMEOUT_KEEP_ALIVE=30 \
    GUNICORN_TIMEOUT=60

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential libpq-dev curl libfreetype6 libexpat1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY src ./src
# BEGIN deploy_manifest:customer_exclude — 자동 생성(scripts/check_deploy_manifest.py --write). 손으로 고치지 않는다.
# 고객사 전용 이미지에서 빼는 파일. 정본: deploy_manifest.toml 의 container.customer_exclude.
RUN rm -f src/koipa/api/synthesis.py \
           src/koipa/dataset_leakage.py \
           src/koipa/modules/m1_synthesis/__init__.py \
           src/koipa/modules/m1_synthesis/generation_playbook.py \
           src/koipa/modules/m1_synthesis/generator.py \
           src/koipa/modules/m1_synthesis/witness_taxonomy.py \
           src/koipa/schemas/synthesis.py \
           src/koipa/services/synth_coverage.py \
           src/koipa/services/synth_provider_status.py \
           src/koipa/services/synth_quality.py \
           src/koipa/services/synthesis_service.py
# END deploy_manifest:customer_exclude
# BEGIN deploy_manifest:container_scripts — 자동 생성(scripts/check_deploy_manifest.py --write). 손으로 고치지 않는다.
# 이미지에는 정본(deploy_manifest.toml)의 container.scripts.allow 만 싣는다.
COPY scripts/_cli_io.py \
     scripts/analyze_golden_run.py \
     scripts/check_domain_leakage_gate.py \
     scripts/docker_install_locked.sh \
     scripts/register_deployed_model.py \
     scripts/setup_console_test_login.py \
     ./scripts/
# END deploy_manifest:container_scripts
COPY alembic ./alembic
COPY alembic.ini ./
COPY evidence ./evidence

ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
RUN pip install --upgrade pip && \
    TORCH_INDEX=${TORCH_INDEX} bash ./scripts/docker_install_locked.sh \
        psh otel jwt hwp hwp-tables pdf-tables xls llm && \
    pip install -U "wheel>=0.46.2" "jaraco.context>=6.1.0"

ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libfreetype.so.6

RUN useradd -m -u 1000 koipa && mkdir -p /app/.storage /app/datasets && chown -R koipa:koipa /app
USER koipa

EXPOSE 8000

CMD ["sh", "-c", "exec gunicorn koipa.api.app:app \
    --bind 0.0.0.0:8000 \
    --workers ${WEB_CONCURRENCY} \
    --worker-class uvicorn.workers.UvicornWorker \
    --timeout ${GUNICORN_TIMEOUT} \
    --keep-alive ${UVICORN_TIMEOUT_KEEP_ALIVE} \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile -"]
