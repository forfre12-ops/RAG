# ============================================================
# Lloydk — 운영(prod) 환경 변수 예시
# 복사: cp .env.prod.example .env.prod
# 적용: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
#
# 주의사항:
#   - 이 파일을 git에 커밋하지 말 것 (.gitignore에 .env.prod 포함 확인)
#   - 실제 시크릿은 외부 vault(HashiCorp Vault, AWS Secrets Manager 등) 또는
#     docker secrets에서 주입하는 것을 권장
# ============================================================

# ── DB / Object Storage ─────────────────────────────────────
# 반드시 dev 기본값(lloydk_dev)에서 변경할 것
POSTGRES_PASSWORD=<강력한_랜덤_패스워드_32자_이상>
MINIO_ROOT_USER=lloydk-prod
MINIO_ROOT_PASSWORD=<강력한_랜덤_패스워드_32자_이상>

# ── 인프라 엔드포인트 ────────────────────────────────────────
# 운영 서버 내부 네트워크 주소 사용 (외부 노출 금지)
DATABASE_URL=postgresql+psycopg://lloydk:<POSTGRES_PASSWORD>@postgres:5432/lloydk
MINIO_ENDPOINT=minio:9000
REDIS_URL=redis://redis:6379/0
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── 벡터 DB ─────────────────────────────────────────────────
VECTOR_BACKEND=es
ES_URL=http://elasticsearch:9200
ES_USERNAME=elastic
ES_PASSWORD=<ES_강력한_패스워드>
ES_API_KEY=
ES_VERIFY_CERTS=true

# ── API 보안 ─────────────────────────────────────────────────
# 시스템 공유 API 키 — 반드시 dev 기본값에서 변경
# 테넌트별 키는 POST /api/v1/admin/tenants/{id}/rotate-api-key 로 발급
API_KEY=<시스템_공유_키_48자_이상_랜덤>

# ── 인증 모드 ────────────────────────────────────────────────
# api_key : X-API-Key 헤더 (기본, 폐쇄망 적합)
# jwt     : RS256 JWT (IdP 연동 환경)
# both    : 둘 중 하나 허용
AUTH_MODE=api_key

# JWT 모드 사용 시 (AUTH_MODE=jwt|both)
# JWT_PUBLIC_KEY=<RS256_공개키_PEM>  또는
# JWT_JWKS_PATH=/run/secrets/jwks.json

# ── RBAC (역할 기반 접근제어) ────────────────────────────────
# api_key 모드는 단일 공유키 = 신뢰된 시스템 호출자. 역할은 서버가 고정.
#   API_KEY_ROLE: api_key 인증 시 부여 역할 (admin|reviewer|system|kl_backend).
#     기본 system. admin 전용 엔드포인트(예: 테넌트 키 로테이션)는 이 값으로 접근 불가.
#   API_KEY_TRUST_ACTOR_ROLE_HEADER: 반드시 false. true면 X-Actor-Role 헤더로
#     누구나 admin 자칭 가능 → 운영 startup fail-fast로 차단됨.
API_KEY_ROLE=system
API_KEY_TRUST_ACTOR_ROLE_HEADER=false
#
# [중요] 운영 RBAC 흐름:
#   - admin 전용 작업(테넌트 키 로테이션 POST /admin/tenants/{id}/rotate-api-key 등)은
#     api_key 모드(role=system)에서 403. admin roles를 담은 RS256 JWT가 필요.
#   - 따라서 admin 운영이 필요하면 AUTH_MODE=both 로 두고, 일반 호출은 X-API-Key,
#     admin 작업만 Authorization: Bearer <admin JWT> 로 수행하는 구성을 권장.
#   - 폐쇄망에서 JWT IdP가 없으면 API_KEY_ROLE=admin 로 올릴 수 있으나, 이때 공유키
#     보유자 전원이 admin 권한을 가지므로 키 배포 범위를 최소화할 것.

# ── LLM 제공자 ──────────────────────────────────────────────
# 폐쇄망(onprem-local): local_openai + 내부 vLLM 서버
# 클라우드 연동: anthropic | openai
LLM_PROVIDER=local_openai
LLM_MODEL=Qwen/Qwen3-14B
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LOCAL_LLM_BASE_URL=http://vllm:8001/v1
LOCAL_LLM_MODEL=Qwen/Qwen3-14B
LOCAL_LLM_API_KEY=EMPTY
LOCAL_LLM_ENABLE_THINKING=false

# ── 임베딩 / 모델 ────────────────────────────────────────────
EMBEDDING_MODEL=nlpai-lab/KURE-v1
CLASSIFIER_BASE_MODEL=kakaobank/kf-deberta-base

# 분류 학습 가중치 — readiness 게이트가 보증하는 모델과 반드시 일치(model parity).
# 불일치 시 operational-readiness가 BLOCKED 처리(게이트 F1/FNR이 라이브를 설명 못 함).
# 2026-06-03 디오염 홀드아웃(109건) 정직 비교 — v3의 0.830은 train-on-test 오염이라 폐기:
#   v4_cost2/v-437ec196 : FNR 0.056 / F1 0.634 / R:S1 0.42 ← 채택 (비대칭 cost=2.0 재학습)
#   v4_clean/v-dd3abab9 : FNR 0.167 / F1 0.632 (cost 미적용 clean 베이스)
# 주의: 정직 F1 0.634 < KPI 0.75 → readiness는 P1 정직 FAIL. 미탐은 3배↓지만 KPI 미충족.
#       진짜 해결은 다양한 실제 S1 데이터(임계·cost는 한계). reports/fnr_threshold_sweep*.md 참조.
CLASSIFIER_MODEL_DIR=artifacts/classifier_p1_retrain_v4_step3/v-f9b5cedb

# ── MinIO 버킷 ───────────────────────────────────────────────
MINIO_BUCKET_DOCS=lloydk-docs
MINIO_BUCKET_MODELS=lloydk-models
MINIO_BUCKET_MLFLOW=mlflow

# ── 배포 프로파일 ─────────────────────────────────────────────
# onprem-local : 폐쇄망 GPU 서버 (LLM·임베딩 모두 로컬)
# lite-cloud   : 외부 LLM API + 로컬 임베딩
DEPLOY_PROFILE=onprem-local
POC_MODE=full

# ── CORS ────────────────────────────────────────────────────
# 운영에서는 와일드카드(*) 절대 사용 금지
CORS_ALLOW_ORIGINS=https://your-internal-domain.corp

# ── 학습 라우터 ──────────────────────────────────────────────
# 폐쇄망 운영에서는 false 권장 (학습은 별도 파이프라인에서)
ENABLE_TRAINING=false

# ── 로깅 ────────────────────────────────────────────────────
LOG_LEVEL=INFO
