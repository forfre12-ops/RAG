# 부주의 커밋·서빙 노출 차단 — 필요 시 개별 `git add -f`. 추적 픽스처는 success_*.docx/.xlsx 뿐이라
# 확장자 글롭이 안전(그 외 pdf/hwp/hwpx는 전부 커밋 대상 아닌 실문서).
poc/src/lloydk/api/static/samples/*.hwp
poc/src/lloydk/api/static/samples/*.hwpx
poc/src/lloydk/api/static/samples/*.pdf
